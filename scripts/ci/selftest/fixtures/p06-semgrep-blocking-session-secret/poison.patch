+// P06 ASSURANCE poison — a hardcoded fallback for APP_SESSION_SECRET, which
+// the blocking Semgrep rule dime-session-secret-fallback rejects at ERROR
+// severity. Inert patch bytes; applied only inside a candidate worktree.
+export function p06SessionSecret(): string {
+  return process.env.APP_SESSION_SECRET || "unset";
+}
