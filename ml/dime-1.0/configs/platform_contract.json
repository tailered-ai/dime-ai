      "roster_status": "proposed_inactive_ai_agent_assignments",
      "activation_authorized": false,
      "ai_agent_activation_authorized": false,
      "agent_receipt_verifier_status": "not_implemented",
      "allowed_principal_types": [
        "human",
        "ai_agent"
