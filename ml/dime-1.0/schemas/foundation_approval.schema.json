{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dime.internal/schemas/foundation_approval.schema.json",
  "title": "Dime Foundation v1 Dataset Approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_version",
    "approved",
    "approved_at_utc",
    "evidence_valid_until_utc",
    "approver_ids",
    "train_sha256",
    "validation_sha256",
    "source_registry_sha256",
    "source_artifacts_sha256",
    "review_ledger_sha256",
    "reviewer_registry_sha256",
    "candidate_audit_sha256",
    "dataset_card_sha256",
    "curriculum_config_sha256",
    "system_prompt_sha256",
    "chat_template_sha256",
    "tool_catalog_sha256",
    "foundation_build_config_sha256",
    "development_eval_repo_id",
    "development_eval_revision",
    "development_eval_manifest_sha256",
    "development_eval_identity_sha256",
    "audit_reports",
    "locked_evaluation_reference",
    "deletion_policy_id",
    "limitations_notes"
  ],
  "properties": {
    "schema_version": {
      "const": "dime-foundation-approval-v1"
    },
    "dataset_version": {
      "const": "dime-sft-foundation-v1"
    },
    "approved": {
      "const": true
    },
    "approved_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_valid_until_utc": {
      "type": "string",
      "format": "date-time"
    },
    "approver_ids": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "agent_decision_receipts": {
      "type": "object",
      "description": "Exact approver_id-to-receipt-digest map for every AI-agent approver and no human approvers.",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      }
    },
    "train_sha256": {"$ref": "#/$defs/sha256"},
    "validation_sha256": {"$ref": "#/$defs/sha256"},
    "source_registry_sha256": {"$ref": "#/$defs/sha256"},
    "source_artifacts_sha256": {"$ref": "#/$defs/sha256"},
    "review_ledger_sha256": {"$ref": "#/$defs/sha256"},
    "reviewer_registry_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_audit_sha256": {"$ref": "#/$defs/sha256"},
    "dataset_card_sha256": {"$ref": "#/$defs/sha256"},
    "curriculum_config_sha256": {"$ref": "#/$defs/sha256"},
    "system_prompt_sha256": {"$ref": "#/$defs/sha256"},
    "chat_template_sha256": {"$ref": "#/$defs/sha256"},
    "tool_catalog_sha256": {"$ref": "#/$defs/sha256"},
    "foundation_build_config_sha256": {"$ref": "#/$defs/sha256"},
    "development_eval_repo_id": {
      "const": "taileredsports/dime-eval-development"
    },
    "development_eval_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "development_eval_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "development_eval_identity_sha256": {"$ref": "#/$defs/sha256"},
    "audit_reports": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_deduplication",
        "privacy_and_identifiers",
        "rights",
        "development_evaluation_contamination",
        "locked_evaluation_contamination",
        "numeric_traceability"
      ],
      "properties": {
        "semantic_deduplication": {"$ref": "#/$defs/audit"},
        "privacy_and_identifiers": {"$ref": "#/$defs/audit"},
        "rights": {"$ref": "#/$defs/audit"},
        "development_evaluation_contamination": {"$ref": "#/$defs/audit"},
        "locked_evaluation_contamination": {"$ref": "#/$defs/audit"},
        "numeric_traceability": {"$ref": "#/$defs/audit"}
      }
    },
    "locked_evaluation_reference": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|locked-eval-(?:approval|suite|revision):[a-z0-9][a-z0-9._-]{3,95})$"
    },
    "deletion_policy_id": {
      "type": "string",
      "minLength": 1
    },
    "limitations_notes": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed",
        "report_sha256",
        "tool_id",
        "tool_version",
        "completed_at_utc",
        "reviewer_ids"
      ],
      "properties": {
        "passed": {"const": true},
        "report_sha256": {"$ref": "#/$defs/sha256"},
        "tool_id": {"type": "string", "minLength": 1},
        "tool_version": {"type": "string", "minLength": 1},
        "completed_at_utc": {"type": "string", "format": "date-time"},
        "reviewer_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "agent_decision_receipts": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    }
  }
}
