# =============================================================================
# .env.example — AI Sports Betting
# Copy to .env for local development. Never commit .env.
# All values are placeholders. Obtain real values from your own stores.
# =============================================================================

# -----------------------------------------------------------------------------
# CORE — Session & Database
# -----------------------------------------------------------------------------
# Session cookie signing secret (min 44 chars). Required at boot — server
# throws if absent. Generate with: openssl rand -base64 48
APP_SESSION_SECRET=
# Tailered OS sports-read machine principal (Bearer / x-tailered-sports-secret).
# Distinct from CRON_SECRET. Fail-closed when unset. Never a browser cookie.
TAILERED_OS_SPORTS_READ_SECRET=
# MySQL/TiDB connection string
DATABASE_URL=
# Public-facing origin (e.g. https://aisportsbettingmodels.com)
PUBLIC_ORIGIN=

# -----------------------------------------------------------------------------
# STRIPE — Payments
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=

# -----------------------------------------------------------------------------
# DISCORD — Bot & OAuth
# -----------------------------------------------------------------------------
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_PUBLIC_KEY=
DISCORD_ROLE_AI_MODEL_SUB=

# -----------------------------------------------------------------------------
# AI / LLM
# -----------------------------------------------------------------------------
# Anthropic credentials — direct key OR an Anthropic-compatible gateway.
# Direct Anthropic API key (sent as x-api-key). Leave EMPTY when routing
# through a gateway — Claude Code checks this variable first.
ANTHROPIC_API_KEY=
# --- Anthropic-compatible gateway routing (optional) — references/ai-gateway-setup.md ---
# When both ANTHROPIC_BASE_URL and ANTHROPIC_AUTH_TOKEN are set, ALL Claude
# traffic (Anthropic SDK calls in server/_core/claude.ts, dime-chat SSE, and the
# Claude Agent SDK in server/_core/dimeAgent.ts) routes through the gateway for
# usage monitoring + observability.
# Gateway host, e.g. https://your-gateway.example.com
ANTHROPIC_BASE_URL=
# Gateway API key (sent as Authorization: Bearer). Takes precedence over
# ANTHROPIC_API_KEY when set.
ANTHROPIC_AUTH_TOKEN=
# Optional model override for Agent SDK tasks (default claude-fable-5)
DIME_AGENT_MODEL=

# -----------------------------------------------------------------------------
# SCRAPERS & DATA SOURCES
# -----------------------------------------------------------------------------
KENPOM_EMAIL=
KENPOM_PASSWORD=
VSIN_EMAIL=
VSIN_PASSWORD=
METABET_API_KEY=

# -----------------------------------------------------------------------------
# OPS / INTEGRATIONS
# -----------------------------------------------------------------------------
GMAIL_APP_PASSWORD=
HEARTBEAT_TOKEN=
# Tailered customer-mirror push (optional; both unset = /api/cron/customer-sync no-ops)
# Ingest endpoint, e.g. https://tailered.ai/api/admin/customer-sync
TAILERED_SYNC_URL=
# Shared HMAC-SHA256 secret — must equal the tailered worker's ADMIN_SYNC_SECRET
TAILERED_SYNC_SECRET=

# -----------------------------------------------------------------------------
# DEPLOYMENT — Railway
# See references/railway-deploy.md
# -----------------------------------------------------------------------------
# Railway injects PORT automatically; the server binds it (default 3000 locally).
# Extra exact origins allowed for authenticated mutations (comma-separated) —
# e.g. the Railway domain, https://your-app.up.railway.app.
ADDITIONAL_ALLOWED_ORIGINS=
# Operator-controlled origin suffixes for per-deploy preview URLs (https-only).
# NEVER a bare shared suffix like .up.railway.app — scope to your team/project slug,
# e.g. -yourteam.up.railway.app
ALLOWED_ORIGIN_SUFFIXES=

# -----------------------------------------------------------------------------
# CONFIG (non-secret, but set for a complete local environment)
# -----------------------------------------------------------------------------
LOG_LEVEL=info
PLAYWRIGHT_CHROMIUM_PATH=
# Runtime Answer Routing v1 defaults on when this variable is absent. Set it
# to false for the documented deterministic routing/math rollback path.
DIME_ANSWER_ROUTING_V1_ENABLED=true
# Dime Research Alpha — safe defaults keep the temporary control-model lane off.
# This is separate from the governed Dime 1.0 production provider freeze.
DIME_RESEARCH_ALPHA_ENABLED=false
DIME_RESEARCH_ALPHA_KILL_SWITCH=true
DIME_RESEARCH_ALPHA_ACKNOWLEDGEMENT=
DIME_RESEARCH_ALPHA_MODEL_REVISION=
# Server-owned conversation persistence. Keep false until migration 0121 has
# passed its duplicate-sequence preflight and post-migration verification.
DIME_CHAT_TRACE_V1_ENABLED=false
# Optional release label; code defaults to package version 1.0.0. Trace-enabled
# deployments still fail identity completeness when no Git commit/environment
# identity is supplied by Railway or GIT_COMMIT_SHA/NODE_ENV.
DIME_APPLICATION_VERSION=
# Cost telemetry remains explicitly unavailable unless this path names one
# reviewed, checksum-valid pricing registry with an exact effective entry for
# the provider, model, and model revision. No ad hoc rate fallback is allowed.
DIME_PRICING_REGISTRY_PATH=
DIME_MODEL_BASE_URL=
DIME_MODEL_API_SECRET=
DIME_MODEL_VERSION=
