{
  "cleanupPeriodDays": 365,
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/scripts/prompt-capsule.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/scripts/bootstrap-plugins.sh\"",
            "timeout": 300,
            "statusMessage": "Loading skill arsenal\u2026"
          }
        ]
      },
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/scripts/bootstrap-dime-context.sh\"",
            "timeout": 45,
            "statusMessage": "Loading Dime control-plane context\u2026"
          }
        ]
      },
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/scripts/bootstrap-gstack.sh\"",
            "timeout": 300,
            "statusMessage": "Loading gstack\u2026"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "mcp__plugin_railway_railway__accept-deploy",
      "mcp__plugin_railway_railway__create-deployment",
      "mcp__plugin_railway_railway__create-project",
      "mcp__plugin_railway_railway__create-service",
      "mcp__plugin_railway_railway__delete-feature-flag",
      "mcp__plugin_railway_railway__generate-domain",
      "mcp__plugin_railway_railway__railway-agent",
      "mcp__plugin_railway_railway__redeploy",
      "mcp__plugin_railway_railway__set-feature-flag",
      "mcp__plugin_railway_railway__set-variables",
      "mcp__plugin_railway_railway__update-service",
      "mcp__plugin_railway_railway__list-variables",
      "Bash(rm:*)",
      "Bash(git clean:*)",
      "Bash(git reset --hard:*)"
    ]
  },
