{
  "name": "ai-sports-betting",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch server/_core/index.ts",
    "build": "npm run build:client && node scripts/verify-preview-production.mjs dist/public && npm run build:server",
    "build:client": "vite build",
    "verify:preview-production": "vite build && node scripts/verify-preview-production.mjs dist/public",
    "build:server": "esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist && cp server/nhl_model_engine.py dist/nhl_model_engine.py && cp server/MLBAIModel.py dist/MLBAIModel.py && cp server/StrikeoutModel.py dist/StrikeoutModel.py && cp server/ActionNetworkHRPropsAPI.py dist/ActionNetworkHRPropsAPI.py && cp server/ActionNetworkF5NrfiAPI.py dist/ActionNetworkF5NrfiAPI.py && cp server/wc2026/wc2026BracketScraper.mjs dist/wc2026BracketScraper.mjs && cp server/wc2026/v27_jul18_engine.mjs dist/v27_jul18_engine.mjs && cp server/wc2026/wc2026AuditEngine.mjs dist/wc2026AuditEngine.mjs && cp server/wc2026/groupStageGameIds.json dist/groupStageGameIds.json",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc --noEmit",
    "check:bundle": "node scripts/check-bundle-budget.mjs dist/public",
    "check:federation": "node scripts/check-federation-docs.mjs",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:stripe-e2e": "node scripts/stripe-e2e.mjs",
    "connection:status": "node scripts/dime-control-plane.mjs status",
    "connection:context": "node scripts/dime-control-plane.mjs context",
    "connection:refresh": "node scripts/dime-control-plane.mjs status --refresh",
    "connection:doctor": "node scripts/dime-control-plane.mjs doctor",
    "connection:targets": "node scripts/dime-control-plane.mjs targets",
    "connection:test": "vitest run scripts/dime-control-plane.test.ts",
    "agent:context": "node scripts/dime-agent-access.mjs context",
    "agent:doctor": "node scripts/dime-agent-access.mjs doctor",
    "agent:access:test": "vitest run scripts/dime-agent-access.test.ts scripts/dime-production-auth.test.ts scripts/dime-trusted-executables.test.ts scripts/dime-authentication-closure.test.ts",
    "auth:closure:candidate": "node scripts/build-dime-authentication-closure.mjs",
    "railway:keychain:install": "node scripts/install-dime-railway-keychain.mjs",
    "railway:keychain:status": "node -e \"import('./scripts/dime-railway-secure.mjs').then(async m => console.log(JSON.stringify(await m.verifySecureRailwayBroker())))\"",
    "security:actions": "node scripts/check-github-actions-security.mjs",
    "credential:verify": "node scripts/dime-agent-access.mjs credential",
    "platform:auth:owner": "node scripts/dime-production-auth.mjs verify --role owner",
    "platform:auth:user": "node scripts/dime-production-auth.mjs verify --role user",
    "platform:auth:open:owner": "node scripts/dime-production-auth.mjs verify --role owner --headed",
    "platform:auth:open:user": "node scripts/dime-production-auth.mjs verify --role user --headed",
    "platform:auth:invalidate:owner": "node scripts/dime-production-auth.mjs invalidate --role owner",
    "platform:auth:invalidate:user": "node scripts/dime-production-auth.mjs invalidate --role user",
    "test:gated:local": "(vitest run --reporter=default --reporter=json --outputFile=vitest-results.json || true) && node scripts/check-environment-failures.mjs --profile=local --input=vitest-results.json --report=env-gate-report.json",
    "test:gated:ci": "(vitest run --reporter=default --reporter=json --outputFile=vitest-results.json || true) && node scripts/check-environment-failures.mjs --profile=ci --input=vitest-results.json --actor=\"$GITHUB_ACTOR\" --report=env-gate-report.json",
    "smoke-test": "node -e \"import('./dist/index.js').then(() => { console.log('[SMOKE] Server initialized without crash'); process.exit(0); }).catch(e => { console.error('[SMOKE] CRASH:', e.message); process.exit(1); })\" & sleep 8 && kill %1 2>/dev/null; wait",
    "db:push": "drizzle-kit generate && JOURNAL_PROFILE=railway-production-v1 MODE=apply CONFIRM=RECONCILE node scripts/reconciled-migrate.mjs",
    "db:migrate:plan": "node scripts/reconciled-migrate.mjs",
    "db:migrate:production:plan": "JOURNAL_PROFILE=railway-production-v1 node scripts/reconciled-migrate.mjs",
    "db:migrate:production:apply": "JOURNAL_PROFILE=railway-production-v1 MODE=apply CONFIRM=RECONCILE node scripts/reconciled-migrate.mjs",
    "db:migrate:reconciled": "MODE=apply CONFIRM=RECONCILE node scripts/reconciled-migrate.mjs",
    "pi": "pi -a",
    "pi:ship": "pi -a --name ship /ship",
    "pi:review": "pi -p -a \"/review branch\"",
    "pi:rpc": "pi --mode rpc -a",
    "pi:json": "pi --mode json -a",
    "pi:audit": "tsx scripts/pi-harness-audit.ts",
    "qm:pack:verify": "tsx scripts/qm-pack-verify.ts",
    "postinstall": "if [ -f requirements.txt ] && command -v pip3 >/dev/null 2>&1; then pip3 install -r requirements.txt -q; else echo '[postinstall] skipping python deps: pip3 unavailable or requirements.txt missing (expected on Railway, which installs via apt in Dockerfile)'; fi"
  },
