{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aisportsbettingmodels.com/schemas/tailered-os-control-plane.v1.json",
  "title": "Tailered OS control plane v1",
  "description": "Stable identifiers and authority metadata for the Tailered OS organizational control plane. Documentation schema in the style of dime-agent-access.schema.json — real enforcement is scripts/tailered-os-control-plane.mjs plus its vitest suite. Contains identifiers only, never dynamic company data and never secrets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "authorityBoundaries",
    "notion",
    "github",
    "safety"
  ],
  "properties": {
    "$schema": { "const": "./tailered-os-control-plane.schema.json" },
    "schemaVersion": { "const": 1 },
    "kind": { "const": "tailered-os-control-plane" },
    "authorityBoundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "notion",
        "github",
        "railway",
        "stripe",
        "credentialBrokers"
      ],
      "properties": {
        "notion": { "type": "string", "minLength": 1 },
        "github": { "type": "string", "minLength": 1 },
        "railway": { "type": "string", "minLength": 1 },
        "stripe": { "type": "string", "minLength": 1 },
        "credentialBrokers": { "type": "string", "minLength": 1 }
      }
    },
    "notion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pageUrlTemplate",
        "workspaceRootPage",
        "taileredOsProject",
        "commandCenter",
        "communicationStandard",
        "executionContract",
        "databases"
      ],
      "properties": {
        "pageUrlTemplate": { "const": "https://app.notion.com/p/{id}" },
        "workspaceRootPage": { "$ref": "#/$defs/notionNode" },
        "taileredOsProject": { "$ref": "#/$defs/notionNode" },
        "commandCenter": { "$ref": "#/$defs/notionNode" },
        "communicationStandard": { "$ref": "#/$defs/notionNode" },
        "executionContract": { "$ref": "#/$defs/notionNode" },
        "databases": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tasks",
            "projects",
            "aiSystemsRegistry",
            "decisions",
            "risks",
            "releases",
            "knowledge"
          ],
          "properties": {
            "tasks": { "$ref": "#/$defs/notionNode" },
            "projects": { "$ref": "#/$defs/notionNode" },
            "aiSystemsRegistry": { "$ref": "#/$defs/notionNode" },
            "decisions": { "$ref": "#/$defs/notionNode" },
            "risks": { "$ref": "#/$defs/notionNode" },
            "releases": { "$ref": "#/$defs/notionNode" },
            "knowledge": { "$ref": "#/$defs/notionNode" }
          }
        }
      }
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "taileredOsBoundary", "foundationPullRequest"],
      "properties": {
        "repository": { "const": "tailered-ai/dime-ai" },
        "taileredOsBoundary": { "const": "platform/tailered-os/" },
        "foundationPullRequest": { "const": 496 }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "notionWriteOperationsAuthorized",
        "secretMaterialAllowed",
        "manualGithubMirroringAllowed"
      ],
      "properties": {
        "notionWriteOperationsAuthorized": { "const": false },
        "secretMaterialAllowed": { "const": false },
        "manualGithubMirroringAllowed": { "const": false }
      }
    }
  },
  "$defs": {
    "notionNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "id", "verified", "source"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "verified": { "type": "boolean" },
        "verifiedOn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "source": { "type": "string", "minLength": 1 }
      }
    }
  }
}
